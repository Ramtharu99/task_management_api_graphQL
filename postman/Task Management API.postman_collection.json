{
  "info": {
    "_postman_id": "088ce92c-53d9-45dd-abe8-2854a6a741ae",
    "name": "Task Management API",
    "description": "GraphQL Task Management API. Every request is a POST to {{baseUrl}}/graphql with a JSON body\ncontaining \"query\" and \"variables\".\n\nFlow: run Auth \u2192 Register (or Login) first. The token is saved to the `token` collection\nvariable and sent automatically as \"Authorization: Bearer {{token}}\" by every task request.\nEach user only sees and manages their own tasks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "name",
      "value": "Test User",
      "type": "string",
      "description": "Name used by Register."
    },
    {
      "key": "email",
      "value": "",
      "type": "string",
      "description": "Set automatically by Register (a unique address per run). Set it yourself to log in as an existing user."
    },
    {
      "key": "password",
      "value": "Passw0rd!123",
      "type": "string",
      "description": "Password used by Register and Login (test accounts only)."
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT saved by Register/Login."
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string",
      "description": "Id of the task created by Create Task."
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Create an account or log in. Both return a JWT that is saved to the `token` variable.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($input: RegisterInput!) { register(input: $input) { token user { id name email createdAt } } }",
                "variables": "{\n  \"input\": {\n    \"name\": \"{{name}}\",\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Creates a new user. The pre-request script generates a unique email so the collection can be re-run."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(json.errors, JSON.stringify(json.errors)).to.be.undefined);",
                  "pm.test('returns a token and the user', () => {",
                  "  pm.expect(json.data.register.token).to.be.a('string');",
                  "  pm.expect(json.data.register.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "});",
                  "if (json.data && json.data.register) pm.collectionVariables.set('token', json.data.register.token);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email per run so Register never collides with an existing account.",
                  "pm.collectionVariables.set('email', `user.${Date.now()}@example.com`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($input: LoginInput!) { login(input: $input) { token user { id name email } } }",
                "variables": "{\n  \"input\": {\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Logs in with {{email}} / {{password}} and saves the returned JWT to `token`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(json.errors, JSON.stringify(json.errors)).to.be.undefined);",
                  "pm.test('returns a token', () => pm.expect(json.data.login.token).to.be.a('string'));",
                  "if (json.data && json.data.login) pm.collectionVariables.set('token', json.data.login.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Me { me { id name email createdAt } }",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Returns the logged-in user (requires the Bearer token)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(json.errors, JSON.stringify(json.errors)).to.be.undefined);",
                  "pm.test('returns the current user', () => pm.expect(json.data.me.email).to.eql(pm.collectionVariables.get('email')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tasks",
      "description": "Task operations. All require the Bearer token and only touch the logged-in user's tasks.",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateTask($input: CreateTaskInput!) { createTask(input: $input) { id title description completed priority dueDate createdAt updatedAt } }",
                "variables": "{\n  \"input\": {\n    \"title\": \"Learn GraphQL\",\n    \"description\": \"Build a task management API\",\n    \"priority\": \"HIGH\",\n    \"dueDate\": \"2026-11-01T12:00:00.000Z\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Creates a task. Only title is required; priority defaults to MEDIUM and completed to false. Saves the id to `taskId`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(json.errors, JSON.stringify(json.errors)).to.be.undefined);",
                  "pm.test('task created with defaults', () => {",
                  "  pm.expect(json.data.createTask.title).to.eql('Learn GraphQL');",
                  "  pm.expect(json.data.createTask.completed).to.eql(false);",
                  "});",
                  "if (json.data && json.data.createTask) pm.collectionVariables.set('taskId', json.data.createTask.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Tasks",
