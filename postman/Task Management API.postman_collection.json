              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(json.errors, JSON.stringify(json.errors)).to.be.undefined);",
                  "pm.test('statistics are consistent', () => {",
                  "  const s = json.data.taskStatistics;",
                  "  pm.expect(s.pendingTasks).to.eql(s.totalTasks - s.completedTasks);",
                  "  pm.expect(s.tasksByPriority.reduce((n, p) => n + p.count, 0)).to.eql(s.totalTasks);",
                  "});"
                ]
              }
            }
